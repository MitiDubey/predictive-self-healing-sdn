# Cornerstone SDN Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or tokens to GitHub!

# GitHub Personal Access Token (for local scripting / CI)
GITHUB_TOKEN=your_personal_access_token_here

# Controller & Dashboard Configuration
CORNERSTONE_ROOT=/opt/cornerstone
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0

